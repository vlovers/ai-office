{
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@openai/codex-sdk": "0.162.1",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "name": "ai-office",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Local-first, provider-neutral coding agent dashboard",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev:delivery": "node --import tsx src/server/delivery-security-index.ts",
    "start:delivery": "node dist/server/delivery-security-index.js",
    "delivery:admin": "node --import tsx scripts/delivery-admin.ts",
    "lint": "eslint src/server/delivery-*.ts scripts/delivery-admin.ts tests/delivery-*.ts tests/fixtures/delivery-security.ts --max-warnings=0",
    "dev": "node --import tsx src/server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "test": "vitest run --exclude tests/smoke.test.ts",
    "test:smoke": "vitest run tests/smoke.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:smoke && npm run build",
    "test:sandbox": "node --import tsx tests/native-sandbox.ts",
    "test:browser": "node --import tsx tests/browser-smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier tests/workflow-restart-dashboard.test.ts | diff -u tests/workflow-restart-dashboard.test.ts - || true; prettier --check .",
    "codex:inspect": "node --import tsx scripts/codex-inspect.ts",
    "test:real": "node --import tsx scripts/real-codex-smoke.ts --run",
    "test:dashboard:real": "node --import tsx tests/dashboard-real.ts --run",
    "test:real:write": "node --import tsx scripts/real-write-smoke.ts",
    "test:browser:write": "node --import tsx tests/browser-write-smoke.ts",
    "test:browser:studio": "node --import tsx tests/browser-studio-smoke.ts",
    "test:workflow:native": "vitest run tests/workflow-execution.test.ts tests/qa-runner.test.ts",
    "test:browser:workflow": "node --import tsx tests/browser-workflow-smoke.ts && node --import tsx tests/browser-workflow-restart.ts",
    "test:real:workflow": "node --import tsx scripts/real-workflow-smoke.ts --run",
    "test:browser:office": "node --import tsx tests/browser-office-smoke.ts"
  }
}
